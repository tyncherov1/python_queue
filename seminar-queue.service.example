# Пример systemd-сервиса для автозапуска бота и доски на домашнем Linux-ПК
# 1. Замените YOUR_USER и /home/YOUR_USER/queue_python на свои пути
# 2. Скопируйте файл:
#      sudo cp seminar-queue.service.example /etc/systemd/system/seminar-queue.service
# 3. Включите и запустите:
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now seminar-queue
# 4. Логи:
#      journalctl -u seminar-queue -f

[Unit]
Description=Seminar Queue Telegram Bot & Electronic Whiteboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/queue_python
ExecStart=/home/YOUR_USER/queue_python/.venv/bin/python /home/YOUR_USER/queue_python/run.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
