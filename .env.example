# ============================================================
# Настройки Telegram-бота и веб-доски очереди на семинар
# Скопируйте этот файл в .env и заполните своими значениями
# ============================================================

# Токен бота от @BotFather (обязателен для работы бота;
# если оставить пустым, запустится только сайт в демо-режиме)
BOT_TOKEN=8772556383:AAHADhHEwxW9x4848UoQQ45LpOrZ88E_gQs

# Имя бота без @ (подтягивается автоматически при запуске с BOT_TOKEN,
# можно указать вручную для генерации QR-кода)
BOT_USERNAME=

# Режим работы бота: polling (по умолчанию, удобно локально)
# или webhook (рекомендуется для Render / Koyeb / Hugging Face Spaces)
BOT_MODE=polling

# Публичный HTTPS URL вашего сайта (нужен только если BOT_MODE=webhook)
# Пример: https://seminar-queue.onrender.com
PUBLIC_URL=

# Секретный токен вебхука Telegram (опционально, генерируется автоматически из BOT_TOKEN)
WEBHOOK_SECRET=

# Числовые Telegram ID администраторов через запятую
# Узнать свой ID можно у @userinfobot
# (Админов также можно указать в колонке role=admin файла students.csv)
ADMIN_IDS=

# --- Настройки семинара и таймера ---
# Заголовок на электронной доске
SEMINAR_TITLE=Семинар • Очередь к преподавателю

# Длительность таймера по умолчанию (в минутах, например 7)
DEFAULT_TIMER_MINUTES=7

# Кулдаун между записями одного ученика (в минутах, от записи к записи)
# Позволяет занять второе место в очереди (например #1 и #7) спустя N минут после прошлой записи; 0 — отключить
REJOIN_COOLDOWN_MINUTES=15

# Максимум одновременных мест в очереди на одного ученика (например 2; 0 — без ограничений)
MAX_ACTIVE_SLOTS=2

# Короткий кулдаун после самостоятельного выхода из очереди (в минутах)
CANCEL_COOLDOWN_MINUTES=2

# Сколько следующих человек показывать на правой панели доски по умолчанию
BOARD_VISIBLE_QUEUE=7

# --- Безопасность веб-доски ---
# PIN-код для разблокировки кнопок управления (Старт / Следующий / Настройки)
# на сайте. Если оставить пустым — кнопки доступны сразу.
# Для публичного хостинга рекомендуем задать, например: 1234
# На доске можно открыть сразу разблокированной через https://сайт/?pin=1234
BOARD_PIN=1234

# --- Пути и сервер ---
STUDENTS_CSV=students.csv
DB_PATH=data/queue.db
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Tashkent
